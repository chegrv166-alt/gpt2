{
  "name": "ashen-covenant",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.cjs",
  "author": "Ashen Covenant",
  "description": "A dark fantasy isometric action RPG with painted art and torch lighting, built with Phaser 3 and TypeScript.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.desktop.json",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "desktop": "npm run build && electron .",
    "test:desktop": "playwright test --config desktop/playwright.config.ts",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:desktop": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
