; Ashen Covenant — Godot native RPG episode
config_version=5

[application]
config/name="Ashen Covenant — Имя, которого нет"
config/version="0.7.0-dev"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.045, 1)
